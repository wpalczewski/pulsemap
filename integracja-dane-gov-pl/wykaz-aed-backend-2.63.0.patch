@@ -0,0 +1,95 @@
+"""HackNation 2026 – przygotowanie lokalnego portalu do pokazu wykazu defibrylatorów AED.
+
+Zakłada (idempotentnie):
+* instytucję-właściciela wykazu zbiorczego (Ministerstwo Cyfryzacji),
+* kategorię „Zdrowie” (kod HEAL, używany w imporcie XML),
+* instytucję dysponenta AED (demo),
+* źródło danych typu import XML wskazujące na plik XML generowany przez Pulsmap
+  (zasilanie automatyczne wykazu AED).
+
+Użycie:
+    python manage.py aed_demo_setup [--xml-url https://mcod.local/pulsmap/api/v1/export/dane-gov-pl.xml]
+"""
+
+from django.apps import apps
+from django.conf import settings
+from django.core.management.base import BaseCommand
+
+ORG_COMMON = {
+    "status": "published",
+    "description": "<p>Instytucja utworzona na potrzeby pokazu wykazu defibrylatorów AED (HackNation 2026).</p>",
+    "postal_code": "00-001",
+    "city": "Warszawa",
+    "street_type": "ul.",
+    "street": "Królewska",
+    "street_number": "27",
+    "email": "admin@mcod.local",
+    "epuap": "https://epuap.gov.pl/",
+    "tel": "0048223456789",
+    "website": "https://mcod.local/",
+}
+
+
+class Command(BaseCommand):
+    help = "Przygotowuje lokalny portal do pokazu wykazu defibrylatorów AED (HackNation 2026)."
+
+    def add_arguments(self, parser):
+        parser.add_argument("--xml-url", default="https://mcod.local/pulsmap/api/v1/export/dane-gov-pl.xml")
+
+    def handle(self, *args, **options):
+        Organization = apps.get_model("organizations", "Organization")
+        Category = apps.get_model("categories", "Category")
+        DataSource = apps.get_model("harvester", "DataSource")
+        User = apps.get_model("users", "User")
+        admin = User.objects.filter(is_superuser=True).order_by("id").first()
+
+        owner_pk = int(settings.MAIN_AED_DATASET_OWNER_ORGANIZATION_PK)
+        owner, created = Organization.raw.get_or_create(
+            pk=owner_pk,
+            defaults={
+                **ORG_COMMON,
+                "title": "Ministerstwo Cyfryzacji",
+                "slug": "ministerstwo-cyfryzacji",
+                "abbreviation": "MC",
+                "institution_type": "state",
+                "regon": "147100154",
+            },
+        )
+        self.stdout.write(f"Właściciel wykazu zbiorczego: {owner.title} (pk={owner.pk}, nowa={created})")
+
+        category, created = Category.raw.get_or_create(
+            code="HEAL",
+            defaults={"title": "Zdrowie", "slug": "zdrowie", "status": "published", "color": "#00875A"},
+        )
+        self.stdout.write(f"Kategoria: {category.title} ({category.code}, nowa={created})")
+
+        disponent, created = Organization.raw.get_or_create(
+            slug="dysponent-aed-pulsmap-demo",
+            defaults={
+                **ORG_COMMON,
+                "title": "Dysponent AED – Pulsmap (demo)",
+                "abbreviation": "AED",
+                "institution_type": "local",
+                "regon": "092355640",
+            },
+        )
+        self.stdout.write(f"Dysponent AED: {disponent.title} (pk={disponent.pk}, nowy={created})")
+
+        source, created = DataSource.raw.get_or_create(
+            name="Pulsmap – wykaz defibrylatorów AED (import XML)",
+            defaults={
+                "description": "Automatyczne zasilanie wykazu defibrylatorów AED z pliku XML generowanego przez Pulsmap.",
+                "source_type": "xml",
+                "xml_url": options["xml_url"],
+                "frequency_in_days": 1,
+                "status": "active",
+                "institution_type": "local",
+                "emails": "admin@mcod.local",
+                "organization": disponent,
+                "created_by": admin,
+                "modified_by": admin,
+            },
+        )
+        if not created and source.xml_url != options["xml_url"]:
+            DataSource.raw.filter(pk=source.pk).update(xml_url=options["xml_url"])
+        self.stdout.write(f"Źródło danych: {source.name} (pk={source.pk}, nowe={created}) → {options['xml_url']}")
