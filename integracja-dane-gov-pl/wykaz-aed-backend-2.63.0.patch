diff --git a/mcod/resources/aed_constants.py b/mcod/resources/aed_constants.py
new file mode 100644
index 0000000..e97f509
--- /dev/null
+++ b/mcod/resources/aed_constants.py
@@ -0,0 +1,51 @@
+"""Wykaz defibrylatorów AED – zakres kolumn (akcja „Otwórz AED”, HackNation 2026).
+
+Mechanizm jest analogiczny do wykazu zasobów chronionych danych (DGA):
+
+* AED_COLUMNS opisuje strukturę pojedynczego wykazu AED, który publikuje
+  dysponent (zasób oznaczony flagą `contains_aed_data`),
+* MAIN_AED_REQUIRED_SOURCE_COLUMNS – kolumny, które muszą mieć wartości, aby
+  rekord trafił do wykazu zbiorczego,
+* MAIN_AED_COLUMNS – struktura ogólnopolskiego wykazu zbiorczego, budowanego
+  codziennie z wykazów wszystkich dysponentów.
+
+Kod do szafki AED nie jest częścią otwartego wykazu – publikujemy jedynie
+informację, czy szafka jest zamykana na kod.
+"""
+
+from typing import List
+
+AED_RESOURCE_EXTENSIONS: List[str] = ["xlsx", "xls", "csv"]
+
+AED_COLUMNS: List[str] = [
+    "Lp.",
+    "Identyfikator AED",
+    "Szerokość geograficzna",
+    "Długość geograficzna",
+    "Miejscowość",
+    "Ulica i numer",
+    "Kod pocztowy",
+    "Województwo",
+    "Opis lokalizacji",
+    "Wewnątrz budynku",
+    "Dostępność",
+    "Szafka zamykana na kod",
+    "Godziny dostępności",
+    "Status",
+    "Opiekun urządzenia",
+    "Telefon opiekuna",
+    "E-mail opiekuna",
+    "Data aktualizacji danych",
+]
+
+MAIN_AED_REQUIRED_SOURCE_COLUMNS: List[str] = [
+    "Identyfikator AED",
+    "Szerokość geograficzna",
+    "Długość geograficzna",
+    "Godziny dostępności",
+    "Status",
+]
+
+MAIN_AED_DISPONENT_COLUMN: str = "Nazwa dysponenta danych"
+
+MAIN_AED_COLUMNS: List[str] = ["Lp.", MAIN_AED_DISPONENT_COLUMN] + AED_COLUMNS[1:]
diff --git a/mcod/resources/aed_utils.py b/mcod/resources/aed_utils.py
new file mode 100644
index 0000000..d91c65e
--- /dev/null
+++ b/mcod/resources/aed_utils.py
@@ -0,0 +1,268 @@
+"""Wykaz defibrylatorów AED – walidacja wykazów dysponentów i wykaz zbiorczy.
+
+Logika odpowiada wykazowi zasobów chronionych danych (DGA, `dga_utils.py`):
+
+1. Dysponent AED publikuje zasób oznaczony flagą `contains_aed_data`:
+   ręcznie (panel administracyjny – plik musi mieć kolumny `AED_COLUMNS`)
+   albo automatycznie (import XML z elementem `containsAedData`).
+2. Zadanie Celery `create_main_aed_resource_task` codziennie scala wszystkie
+   opublikowane wykazy AED w jeden ogólnopolski wykaz zbiorczy (XLSX),
+   publikowany jako zasób w zbiorze „Wykaz defibrylatorów AED – raport zbiorczy”.
+"""
+
+import datetime
+import logging
+import os
+from io import BytesIO
+from pathlib import Path
+from typing import TYPE_CHECKING, List, Optional, Union
+
+import pandas as pd
+import requests
+from django.apps import apps
+from django.conf import settings
+from django.core.exceptions import ObjectDoesNotExist
+from django.core.files.uploadedfile import InMemoryUploadedFile, SimpleUploadedFile
+from django.db import transaction
+from django.db.models import QuerySet
+
+from mcod.core.utils import save_df_to_xlsx
+from mcod.resources.aed_constants import (
+    AED_COLUMNS,
+    MAIN_AED_COLUMNS,
+    MAIN_AED_DISPONENT_COLUMN,
+    MAIN_AED_REQUIRED_SOURCE_COLUMNS,
+)
+from mcod.resources.dga_utils import (
+    create_df_from_dga_file,
+    get_remote_extension_if_correct_dga_content_type,
+    request_remote_dga,
+)
+
+if TYPE_CHECKING:
+    from mcod.resources.models import Dataset, Resource
+
+logger = logging.getLogger("mcod")
+
+
+class MainAEDResourceReadError(Exception):
+    """Nie udało się odczytać wykazu AED dysponenta."""
+
+
+# ── Walidacja pojedynczego wykazu AED (zasilanie ręczne i automatyczne) ──
+def create_df_from_aed_file(file: Union[InMemoryUploadedFile, BytesIO], extension: Optional[str]) -> Optional[pd.DataFrame]:
+    """DataFrame z pliku xlsx/xls/csv (te same reguły odczytu co dla DGA)."""
+    return create_df_from_dga_file(file, extension)
+
+
+def validate_aed_df_columns(df: pd.DataFrame) -> bool:
+    """True, jeśli kolumny mają dokładnie nazwy i kolejność z `AED_COLUMNS`."""
+    return [str(c).strip() for c in df.columns.to_list()] == AED_COLUMNS
+
+
+def validate_aed_file_columns(file: Union[InMemoryUploadedFile, BytesIO], extension: Optional[str]) -> bool:
+    try:
+        df: Optional[pd.DataFrame] = create_df_from_aed_file(file, extension)
+    except Exception as exc:  # noqa: BLE001 – każdy błąd odczytu oznacza zły plik
+        logger.exception(f"Error reading AED file: {exc}")
+        return False
+    finally:
+        if hasattr(file, "seek"):
+            file.seek(0)
+    return df is not None and validate_aed_df_columns(df)
+
+
+# ── Wykaz zbiorczy ────────────────────────────────────────────────────────
+def get_main_aed_resource() -> Optional["Resource"]:
+    AggregatedAEDInfo = apps.get_model("resources", "AggregatedAEDInfo")
+    info = AggregatedAEDInfo.objects.last()
+    return info.main_aed_resource if info else None
+
+
+def get_main_aed_dataset() -> Optional["Dataset"]:
+    AggregatedAEDInfo = apps.get_model("resources", "AggregatedAEDInfo")
+    info = AggregatedAEDInfo.objects.last()
+    if info and info.main_aed_dataset:
+        return info.main_aed_dataset
+    # Zbiór mógł powstać w nieudanym wcześniej uruchomieniu (zanim zapisano
+    # AggregatedAEDInfo) – używamy go zamiast tworzyć drugi o tej samej nazwie.
+    Dataset = apps.get_model("datasets", "Dataset")
+    return (
+        Dataset.objects.filter(
+            title=settings.MAIN_AED_DATASET_DEFAULT_TITLE,
+            organization_id=settings.MAIN_AED_DATASET_OWNER_ORGANIZATION_PK,
+            status="published",
+        )
+        .order_by("id")
+        .first()
+    )
+
+
+def get_all_aed_resources_sorted_by_organizations() -> QuerySet:
+    """Opublikowane, poprawnie zwalidowane wykazy AED dysponentów (bez wykazu zbiorczego)."""
+    Resource = apps.get_model("resources", "Resource")
+    main = get_main_aed_resource()
+    return (
+        Resource.objects.filter(
+            contains_aed_data=True,
+            status="published",
+            data_tasks_last_status="SUCCESS",
+            file_tasks_last_status="SUCCESS",
+        )
+        .exclude(id=main.pk if main else None)
+        .select_related("dataset__organization")
+        .order_by("dataset__organization__title")
+    )
+
+
+def _read_remote_aed_df(resource: "Resource") -> Optional[pd.DataFrame]:
+    """Wykaz AED zasilany automatycznie: odczyt bezpośrednio ze źródła (link zasobu)."""
+    url: Optional[str] = resource.link
+    if not url:
+        return None
+    try:
+        response: requests.models.Response = request_remote_dga(url)
+    except requests.exceptions.RequestException:
+        logger.exception(f"AED source not responding. Resource id: {resource.pk}; url: {url}")
+        return None
+    if response.status_code != 200:
+        return None
+    extension: Optional[str] = get_remote_extension_if_correct_dga_content_type(response)
+    if extension is None and url.lower().split("?")[0].endswith(".csv"):
+        extension = "csv"
+    if extension is None:
+        return None
+    return create_df_from_aed_file(BytesIO(response.content), extension)
+
+
+def get_main_aed_source_df(resource: "Resource") -> pd.DataFrame:
+    """Wiersze wykazu AED dysponenta w strukturze wykazu zbiorczego."""
+    df: Optional[pd.DataFrame] = None
+    try:
+        data = resource.tabular_data.table.read(keyed=True)
+        df = pd.DataFrame(data)
+    except Exception:  # noqa: BLE001 – brak widoku tabelarycznego → próbujemy źródła
+        df = None
+    if df is None or df.empty:
+        df = _read_remote_aed_df(resource)
+    if df is None:
+        raise MainAEDResourceReadError(f"Cannot read AED resource {resource.pk}")
+
+    df.columns = [str(c).strip() for c in df.columns]
+    missing: List[str] = [c for c in MAIN_AED_REQUIRED_SOURCE_COLUMNS if c not in df.columns]
+    if missing:
+        raise MainAEDResourceReadError(f"AED resource {resource.pk} is missing columns: {', '.join(missing)}")
+
+    df = df.reindex(columns=MAIN_AED_COLUMNS[2:])
+    required = df[MAIN_AED_REQUIRED_SOURCE_COLUMNS]
+    has_missing = (required.isna() | required.astype(str).apply(lambda s: s.str.strip()).eq("")).any(axis=1)
+    if has_missing.any():
+        logger.warning(f"AED resource {resource.pk}: skipping {int(has_missing.sum())} rows with empty required values.")
+        df = df[~has_missing]
+    return df
+
+
+def create_main_aed_df(resources: QuerySet) -> pd.DataFrame:
+    main_df = pd.DataFrame(columns=MAIN_AED_COLUMNS[1:])
+    ok = 0
+    for resource in resources:
+        try:
+            df = get_main_aed_source_df(resource)
+        except MainAEDResourceReadError as exc:
+            logger.error(f"Skipping AED source resource: {exc}")
+            continue
+        if df.empty:
+            continue
+        df.insert(0, MAIN_AED_DISPONENT_COLUMN, resource.institution.title)
+        main_df = pd.concat([main_df, df], ignore_index=True)
+        ok += 1
+    logger.info(f"AED resources aggregated: {ok}/{resources.count()}, rows: {len(main_df)}.")
+
+    # Ten sam AED zgłoszony przez kilku dysponentów – zostaje pierwszy wpis
+    main_df = main_df.drop_duplicates(subset=["Identyfikator AED"], keep="first")
+    main_df.insert(0, "Lp.", range(1, len(main_df) + 1))
+    return main_df
+
+
+def create_main_aed_file() -> Path:
+    directory = Path(settings.MAIN_AED_RESOURCE_XLSX_CREATION_ROOT)
+    directory.mkdir(parents=True, exist_ok=True)
+    today: str = datetime.datetime.now().strftime("%Y%m%d")
+    file_path = directory / f"{settings.MAIN_AED_XLSX_FILE_NAME_PREFIX} {today}.xlsx"
+    main_df = create_main_aed_df(get_all_aed_resources_sorted_by_organizations())
+    save_df_to_xlsx(df=main_df, file_path=file_path, sheet_name=settings.MAIN_AED_XLSX_WORKSHEET_NAME)
+    return file_path
+
+
+def create_main_aed_dataset() -> "Dataset":
+    Organization = apps.get_model("organizations", "Organization")
+    Dataset = apps.get_model("datasets", "Dataset")
+    Category = apps.get_model("categories", "Category")
+    Tag = apps.get_model("tags", "Tag")
+
+    try:
+        institution = Organization.objects.get(pk=settings.MAIN_AED_DATASET_OWNER_ORGANIZATION_PK)
+    except Organization.DoesNotExist:
+        raise ObjectDoesNotExist("Main AED owner institution not found.")
+
+    with transaction.atomic():
+        dataset = Dataset.objects.create(
+            title=settings.MAIN_AED_DATASET_DEFAULT_TITLE,
+            notes=settings.MAIN_AED_DATASET_DEFAULT_DESC,
+            organization=institution,
+            update_notification_recipient_email=settings.MAIN_AED_DATASET_UPDATE_NOTIFICATION_EMAIL,
+            has_dynamic_data=False,
+            has_high_value_data=False,
+            has_high_value_data_from_ec_list=False,
+            has_research_data=False,
+            update_frequency="daily",
+            status="published",
+        )
+        dataset.categories.set(Category.objects.filter(title__in=settings.MAIN_AED_DATASET_CATEGORIES_TITLES))
+        pl = settings.LANGUAGES[0][0]
+        dataset.tags.set([Tag.objects.get_or_create(name=n, language=pl)[0] for n in settings.MAIN_AED_DATASET_TAGS_NAMES])
+        dataset.save()
+    logger.info(f"Created main AED dataset {dataset.pk}.")
+    return dataset
+
+
+def create_main_aed_resource(file_path: Path) -> "Resource":
+    Resource = apps.get_model("resources", "Resource")
+    ResourceFile = apps.get_model("resources", "ResourceFile")
+
+    old = get_main_aed_resource()
+    dataset = get_main_aed_dataset() or create_main_aed_dataset()
+
+    with transaction.atomic(), open(file_path, "rb") as fh:
+        resource = Resource.objects.create(
+            title=old.title if old else settings.MAIN_AED_RESOURCE_DEFAULT_TITLE,
+            description=old.description if old else settings.MAIN_AED_RESOURCE_DEFAULT_DESC,
+            dataset=dataset,
+            has_dynamic_data=False,
+            has_high_value_data=False,
+            has_high_value_data_from_ec_list=False,
+            has_research_data=False,
+            # Wykaz zbiorczy nie jest wykazem dysponenta – nie może sam siebie scalać
+            contains_aed_data=False,
+            status="published",
+            data_date=datetime.datetime.today(),
+        )
+        mimetype = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
+        django_file = SimpleUploadedFile(name=os.path.basename(fh.name), content=fh.read(), content_type=mimetype)
+        # post_save uruchamia walidację pliku i budowę widoku tabelarycznego
+        ResourceFile.objects.create(resource=resource, is_main=True, file=django_file)
+    return resource
+
+
+def update_aggr_aed_info_and_delete_old_main_aed(new_resource: "Resource") -> None:
+    AggregatedAEDInfo = apps.get_model("resources", "AggregatedAEDInfo")
+    info = AggregatedAEDInfo.objects.last()
+    old = info.main_aed_resource if info else None
+    with transaction.atomic():
+        if info:
+            info.resource = new_resource
+            info.save()
+        else:
+            AggregatedAEDInfo.objects.create(resource=new_resource)
+        if old and old.pk != new_resource.pk:
+            old.delete()
