+++ b/mcod/resources/tasks/aed.py
@@ -0,0 +1,60 @@
+import logging
+
+from django.apps import apps
+
+from mcod.core.tasks import extended_shared_task
+from mcod.resources.aed_utils import (
+    create_main_aed_file,
+    create_main_aed_resource,
+    update_aggr_aed_info_and_delete_old_main_aed,
+)
+from mcod.resources.dga_utils import (
+    FailedValidationException,
+    PendingValidationException,
+    check_all_resource_validations_status,
+)
+
+logger = logging.getLogger("mcod")
+
+
+@extended_shared_task(
+    max_retries=5,
+    atomic=False,
+    retry_countdown=20,
+    retry_on_errors=(PendingValidationException,),
+    bind=True,
+    name="mcod.resources.tasks.create_main_aed_resource_task",
+)
+def create_main_aed_resource_task(self, resource_pk: int = None) -> None:
+    """
+    Buduje ogólnopolski wykaz zbiorczy defibrylatorów AED (analogicznie do
+    `create_main_dga_resource_task`):
+
+    1. scala opublikowane wykazy AED dysponentów w plik XLSX,
+    2. publikuje go jako nowy zasób w zbiorze „Wykaz defibrylatorów AED –
+       raport zbiorczy” (zbiór jest tworzony przy pierwszym uruchomieniu),
+    3. czeka na zakończenie walidacji pliku (widok tabelaryczny),
+    4. podmienia poprzedni wykaz zbiorczy na nowy.
+    """
+    Resource = apps.get_model("resources", "Resource")
+
+    if resource_pk is None:
+        logger.info("Main AED: step 1/2 – creating xlsx file and resource.")
+        file_path = create_main_aed_file()
+        resource_pk = create_main_aed_resource(file_path).pk
+
+    resource = Resource.objects.get(pk=resource_pk)
+    try:
+        logger.info("Main AED: step 2/2 – checking validations of resource %s.", resource_pk)
+        check_all_resource_validations_status(resource)
+    except PendingValidationException:
+        if self.request.retries >= self.max_retries:
+            resource.delete()
+            raise
+        raise self.retry(kwargs={"resource_pk": resource_pk}, countdown=20)
+    except FailedValidationException:
+        resource.delete()
+        raise
+
+    update_aggr_aed_info_and_delete_old_main_aed(resource)
+    logger.info("Main AED resource %s published.", resource_pk)
